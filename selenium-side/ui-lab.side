    }, {
      "id": "24ac161e-5ba3-4335-a681-f9a33ae13a39",
      "comment": "",
      "command": "click",
      "target": "id=my-text-id",
      "targets": [
        ["id=my-text-id", "id"],
        ["name=my-text", "name"],
        ["css=#my-text-id", "css:finder"],
        ["xpath=//input[@id='my-text-id']", "xpath:attributes"],
        ["xpath=//input", "xpath:position"]
      ],
      "value": ""
    }, {
      "id": "f31b7f2b-86b0-4100-b497-fbb9839eafba",
      "comment": "",
      "command": "type",
      "target": "id=my-text-id",
      "targets": [
        ["id=my-text-id", "id"],
        ["name=my-text", "name"],
        ["css=#my-text-id", "css:finder"],
        ["xpath=//input[@id='my-text-id']", "xpath:attributes"],
        ["xpath=//input", "xpath:position"]
      ],
      "value": "Hello Selenium"
    }, {
      "id": "0b5f47b0-2b09-4ac2-bdbf-fe7973e13648",
      "comment": "",
      "command": "select",
      "target": "name=my-select",
      "targets": [],
      "value": "label=Two"
    }, {
      "id": "678282a9-9ccc-403e-a2e3-971cad3c1ee9",
      "comment": "",
      "command": "click",
      "target": "css=.form-select > option:nth-child(3)",
      "targets": [
        ["css=.form-select > option:nth-child(3)", "css:finder"],
        ["xpath=//option[@value='2']", "xpath:attributes"],
        ["xpath=//option[3]", "xpath:position"],
        ["xpath=//option[contains(.,'Two')]", "xpath:innerText"]
      ],
      "value": ""
    }, {
      "id": "2b45fee4-a11b-489b-818b-7092423b1c56",
      "comment": "",
      "command": "click",
      "target": "css=.btn",
      "targets": [
        ["css=.btn", "css:finder"],
        ["xpath=//button[@type='submit']", "xpath:attributes"],
        ["xpath=//button", "xpath:position"],
        ["xpath=//button[contains(.,'Submit')]", "xpath:innerText"]
      ],
      "value": ""
    }]
  }],
